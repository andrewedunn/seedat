// ABOUTME: Wrangler config for seedat-api: the public MCP server (Streamable HTTP, stateless JSON) over seedat-db.
// ABOUTME: Read-only; no secrets. Endpoint: POST /mcp
{
  "name": "seedat-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [{ "binding": "DB", "database_name": "seedat-db", "database_id": "c6aa8f43-0488-48ac-b18a-11dc4308dd7f" }],
  "vars": { "SITE_ORIGIN": "https://seedat-web.andrewdunn.workers.dev" }
}
